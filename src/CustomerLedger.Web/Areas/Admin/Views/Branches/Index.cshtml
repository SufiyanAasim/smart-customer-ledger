@model PagedResult<Branch>
@{
    ViewData["Title"] = "Branches";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Branches</h1>
    <a class="btn btn-primary" asp-action="Create">+ New Branch</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="search" value="@ViewData["search"]" class="form-control" placeholder="Search name, code, city" />
    </div>
    <div class="col-auto form-check pt-2">
        <input type="checkbox" name="includeInactive" value="true" class="form-check-input" @(((bool?)ViewData["includeInactive"]) == true ? "checked" : "") />
        <label class="form-check-label">Include inactive</label>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filter</button>
    </div>
</form>

@if (!Model.Items.Any())
{
    <p class="text-muted">No branches found.</p>
}
else
{
    <table class="table table-striped cl-table">
        <thead>
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>City</th>
                <th>Phone</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var branch in Model.Items)
        {
            <tr>
                <td>@branch.BranchCode</td>
                <td>@branch.Name</td>
                <td>@branch.City</td>
                <td>@branch.PhoneNumber</td>
                <td>
                    @if (branch.IsActive)
                    {
                        <span class="badge cl-status-active">Active</span>
                    }
                    else
                    {
                        <span class="badge cl-status-cancelled">Inactive</span>
                    }
                </td>
                <td>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@branch.BranchId">View</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@branch.BranchId">Edit</a>
                    @if (branch.IsActive)
                    {
                        <form asp-action="Deactivate" asp-route-id="@branch.BranchId" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Deactivate this branch?');">Deactivate</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Reactivate" asp-route-id="@branch.BranchId" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-success">Reactivate</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
    @await Html.PartialAsync("_Pagination", Model, ViewData)
}
