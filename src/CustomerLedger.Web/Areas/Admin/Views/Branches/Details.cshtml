@model Branch
@{
    ViewData["Title"] = "Branch Details";
}

<h1>@Model.Name</h1>

<dl class="row">
    <dt class="col-sm-3">Branch Code</dt>
    <dd class="col-sm-9">@Model.BranchCode</dd>
    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Phone</dt>
    <dd class="col-sm-9">@Model.PhoneNumber</dd>
    <dt class="col-sm-3">Address</dt>
    <dd class="col-sm-9">@Model.Address, @Model.City</dd>
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@(Model.IsActive ? "Active" : "Inactive")</dd>
    <dt class="col-sm-3">Created</dt>
    <dd class="col-sm-9">@Model.CreatedAtUtc.ToString("u")</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.BranchId" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
