@model PagedResult<AuditLog>
@{
    ViewData["Title"] = "Audit Logs";
}

<h1>Audit Logs</h1>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="tableName" value="@ViewData["tableName"]" class="form-control" placeholder="Table name (e.g. Customers)" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filter</button>
    </div>
</form>

<table class="table table-striped table-sm cl-table">
    <thead>
        <tr>
            <th>When (UTC)</th>
            <th>Table</th>
            <th>Record</th>
            <th>Action</th>
            <th>Branch</th>
            <th>Review Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var entry in Model.Items)
    {
        <tr>
            <td>@entry.CreatedAtUtc.ToString("u")</td>
            <td>@entry.TableName</td>
            <td>@entry.RecordId</td>
            <td>@entry.ActionType</td>
            <td>@(entry.BranchId?.ToString() ?? "-")</td>
            <td>@entry.ReviewStatus</td>
            <td>
                @if (entry.ReviewStatus == AuditReviewStatus.Unreviewed)
                {
                    <form asp-action="Review" asp-route-id="@entry.AuditLogId" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-primary">Mark Reviewed</button>
                    </form>
                }
                <form asp-action="Archive" asp-route-id="@entry.AuditLogId" method="post" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-secondary" onclick="return confirm('Archive this entry?');">Archive</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
@await Html.PartialAsync("_Pagination", Model, ViewData)
