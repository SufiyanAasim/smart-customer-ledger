@using CustomerLedger.Application.Results
@model IPagedResult
@{
    // Consumed via @await Html.PartialAsync("_Pagination", Model, ViewData) from list views;
    // ViewData carries the extra route values (search/status/etc.) each list page needs to
    // preserve across page links.
    var routeValues = new Dictionary<string, string?>();
    foreach (var key in ViewData.Keys)
    {
        if (key.StartsWith("route_", StringComparison.Ordinal))
        {
            routeValues[key.Substring("route_".Length)] = ViewData[key]?.ToString();
        }
    }
}
@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                var values = new Dictionary<string, string?>(routeValues) { ["pageNumber"] = p.ToString() };
                <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                    <a class="page-link" asp-all-route-data="values">@p</a>
                </li>
            }
        </ul>
    </nav>
    <p class="text-muted small">
        Showing page @Model.PageNumber of @Model.TotalPages (@Model.TotalCount total records)
    </p>
}
