@model CustomerLedger.Application.DTOs.DashboardSummary
@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="mb-4">Dashboard</h1>

<div class="row g-3">
    <div class="col-md-4 col-lg-2">
        <div class="card cl-card-stat h-100">
            <div class="card-body">
                <div class="text-muted small">Active Customers</div>
                <div class="fs-3 fw-bold">@Model.TotalActiveCustomers</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card cl-card-stat h-100">
            <div class="card-body">
                <div class="text-muted small">Active Invoices</div>
                <div class="fs-3 fw-bold">@Model.TotalActiveInvoices</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card cl-card-stat h-100">
            <div class="card-body">
                <div class="text-muted small">Outstanding Balance</div>
                <div class="fs-3 fw-bold">@Model.TotalOutstandingBalance.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card cl-card-stat h-100">
            <div class="card-body">
                <div class="text-muted small">Overdue Installments</div>
                <div class="fs-3 fw-bold">@Model.OverdueInstallmentCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card cl-card-stat h-100">
            <div class="card-body">
                <div class="text-muted small">Open Interactions</div>
                <div class="fs-3 fw-bold">@Model.OpenInteractionCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card cl-card-stat h-100">
            <div class="card-body">
                <div class="text-muted small">Collected Today</div>
                <div class="fs-3 fw-bold">@Model.TodaysCollectedAmount.ToString("N2")</div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4 g-3">
    <div class="col-md-3">
        <a class="btn btn-primary w-100" asp-controller="Customers" asp-action="Create">+ New Customer</a>
    </div>
    <div class="col-md-3">
        <a class="btn btn-primary w-100" asp-controller="Invoices" asp-action="Create">+ New Invoice</a>
    </div>
    <div class="col-md-3">
        <a class="btn btn-outline-secondary w-100" asp-controller="Payments" asp-action="Index">View Payments</a>
    </div>
    <div class="col-md-3">
        <a class="btn btn-outline-secondary w-100" asp-controller="CustomerInteractions" asp-action="Create">Log Interaction</a>
    </div>
</div>
