@model InstallmentPlan
@{
    ViewData["Title"] = "Installment Plan";
}

<div class="d-flex justify-content-between align-items-center">
    <h1>Installment Plan</h1>
    <span class="badge fs-6 cl-status-@Model.Status.ToString().ToLowerInvariant()">@Model.Status</span>
</div>

<dl class="row">
    <dt class="col-sm-3">Invoice</dt>
    <dd class="col-sm-9"><a asp-controller="Invoices" asp-action="Details" asp-route-id="@Model.InvoiceId">@Model.Invoice?.InvoiceNumber</a></dd>
    <dt class="col-sm-3">Total Installment Amount</dt>
    <dd class="col-sm-9">@Model.TotalInstallmentAmount.ToString("N2")</dd>
    <dt class="col-sm-3">Down Payment</dt>
    <dd class="col-sm-9">@Model.DownPayment.ToString("N2")</dd>
    <dt class="col-sm-3">Frequency</dt>
    <dd class="col-sm-9">@Model.Frequency</dd>
    <dt class="col-sm-3">Start / End</dt>
    <dd class="col-sm-9">@Model.StartDate.ToString("d") - @Model.EndDate.ToString("d")</dd>
</dl>

<h4>Schedule</h4>
<table class="table table-sm cl-table">
    <thead><tr><th>#</th><th>Due Date</th><th>Amount Due</th><th>Amount Paid</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var schedule in Model.Schedules.OrderBy(s => s.InstallmentNumber))
    {
        <tr>
            <td>@schedule.InstallmentNumber</td>
            <td>@schedule.DueDate.ToString("d")</td>
            <td>@schedule.AmountDue.ToString("N2")</td>
            <td>@schedule.AmountPaid.ToString("N2")</td>
            <td><span class="badge cl-status-@schedule.Status.ToString().ToLowerInvariant()">@schedule.Status</span></td>
            <td>
                @if (Model.Status == InstallmentPlanStatus.Active && (schedule.Status == InstallmentStatus.Pending || schedule.Status == InstallmentStatus.Overdue))
                {
                    <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#pay-@schedule.InstallmentScheduleId">
                        Pay
                    </button>
                }
            </td>
        </tr>
        @if (Model.Status == InstallmentPlanStatus.Active && (schedule.Status == InstallmentStatus.Pending || schedule.Status == InstallmentStatus.Overdue))
        {
            <tr class="collapse" id="pay-@schedule.InstallmentScheduleId">
                <td colspan="6">
                    <form asp-action="PayInstallment" method="post" class="row g-2 align-items-end">
                        <input type="hidden" name="planId" value="@Model.InstallmentPlanId" />
                        <input type="hidden" name="scheduleId" value="@schedule.InstallmentScheduleId" />
                        <div class="col-auto">
                            <label class="form-label">Amount</label>
                            <input type="number" step="0.01" min="0.01" name="amount" class="form-control" value="@(schedule.AmountDue - schedule.AmountPaid)" required />
                        </div>
                        <div class="col-auto">
                            <label class="form-label">Method</label>
                            <select name="paymentMethod" class="form-select">
                                @foreach (var method in Enum.GetNames(typeof(PaymentMethod)))
                                {
                                    <option value="@method">@method</option>
                                }
                            </select>
                        </div>
                        <div class="col-auto">
                            <label class="form-label">Reference</label>
                            <input type="text" name="transactionReference" class="form-control" />
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary">Record Payment</button>
                        </div>
                    </form>
                </td>
            </tr>
        }
    }
    </tbody>
</table>

@if (Model.Status == InstallmentPlanStatus.PendingApproval)
{
    <form asp-action="Approve" asp-route-id="@Model.InstallmentPlanId" method="post" class="d-inline">
        <button type="submit" class="btn btn-primary">Approve</button>
    </form>
    <form asp-action="Cancel" asp-route-id="@Model.InstallmentPlanId" method="post" class="d-inline">
        <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Cancel this plan?');">Cancel</button>
    </form>
}

<a asp-controller="Invoices" asp-action="Details" asp-route-id="@Model.InvoiceId" class="btn btn-outline-secondary mt-3">Back to invoice</a>
