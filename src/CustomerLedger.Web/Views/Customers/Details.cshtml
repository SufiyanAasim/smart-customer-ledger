@model Customer
@{
    ViewData["Title"] = "Customer Details";
    var cnicMasked = string.IsNullOrEmpty(Model.CNIC) ? "-" : $"{Model.CNIC[..Math.Min(4, Model.CNIC.Length)]}-XXXXX-{(Model.CNIC.Length >= 4 ? Model.CNIC[^1] : 'X')}";
}

<h1>@Model.FullName <small class="text-muted">(@Model.CustomerCode)</small></h1>

<dl class="row">
    <dt class="col-sm-3">Branch</dt>
    <dd class="col-sm-9">@Model.Branch?.Name</dd>
    <dt class="col-sm-3">Phone</dt>
    <dd class="col-sm-9">@Model.PhoneNumber</dd>
    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">CNIC</dt>
    <dd class="col-sm-9">@cnicMasked</dd>
    <dt class="col-sm-3">Address</dt>
    <dd class="col-sm-9">@Model.Address, @Model.City</dd>
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9"><span class="badge cl-status-@Model.Status.ToString().ToLowerInvariant()">@Model.Status</span></dd>
</dl>

@if (Model.CustomerAccount is not null)
{
    <h4>Financial Account</h4>
    <dl class="row">
        <dt class="col-sm-3">Credit Limit</dt>
        <dd class="col-sm-9">@Model.CustomerAccount.CreditLimit.ToString("N2")</dd>
        <dt class="col-sm-3">Total Billed</dt>
        <dd class="col-sm-9">@Model.CustomerAccount.TotalBilled.ToString("N2")</dd>
        <dt class="col-sm-3">Total Paid</dt>
        <dd class="col-sm-9">@Model.CustomerAccount.TotalPaid.ToString("N2")</dd>
        <dt class="col-sm-3">Current Balance</dt>
        <dd class="col-sm-9">@Model.CustomerAccount.CurrentBalance.ToString("N2")</dd>
    </dl>
}

<a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-primary">Edit</a>
<a asp-controller="Exports" asp-action="CustomerStatement" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-secondary">Account Statement (CSV)</a>
<a asp-controller="Invoices" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-primary">New Invoice</a>
<a asp-controller="CustomerInteractions" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-secondary">Log Interaction</a>
@if (Model.Status == CustomerStatus.Active)
{
    <form asp-action="Deactivate" asp-route-id="@Model.CustomerId" method="post" class="d-inline">
        <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Deactivate this customer?');">Deactivate</button>
    </form>
}
<a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
