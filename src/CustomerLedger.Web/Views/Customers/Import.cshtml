@using CustomerLedger.Domain.Entities
@{
    ViewData["Title"] = "Import Customers";
    var branches = (IEnumerable<Branch>)ViewBag.Branches;
}

<h1>Import Customers</h1>
<p class="text-muted">
    CSV with header row: <code>CustomerCode,FullName,Email,PhoneNumber,CNIC,Address,City</code>.
    Preview first — nothing is written to the database until you confirm.
</p>

<form asp-action="Preview" method="post" enctype="multipart/form-data" class="row g-2 col-md-8">
    <div class="col-md-4">
        <label class="form-label">Branch</label>
        <select name="branchId" class="form-select">
            @foreach (var branch in branches)
            {
                <option value="@branch.BranchId">@branch.Name</option>
            }
        </select>
    </div>
    <div class="col-md-6">
        <label class="form-label">CSV File</label>
        <input type="file" name="file" class="form-control" accept=".csv" required />
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">Preview</button>
    </div>
</form>
