@model PagedResult<Customer>
@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Customers</h1>
    <div>
        <a class="btn btn-outline-secondary" asp-controller="Exports" asp-action="CustomersCsv">Export CSV</a>
        <a class="btn btn-outline-secondary" asp-controller="Exports" asp-action="CustomersJson">Export JSON</a>
        <a class="btn btn-outline-secondary" asp-action="Import">Import CSV</a>
        <a class="btn btn-primary" asp-action="Create">+ New Customer</a>
    </div>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="search" value="@ViewData["search"]" class="form-control" placeholder="Search name, code, phone" />
    </div>
    <div class="col-auto">
        <select name="status" class="form-select">
            <option value="">All statuses</option>
            @foreach (var s in Enum.GetNames(typeof(CustomerStatus)))
            {
                <option value="@s" selected="@(s == (string?)ViewData["status"])">@s</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filter</button>
    </div>
</form>

@if (!Model.Items.Any())
{
    <p class="text-muted">No customers found.</p>
}
else
{
    <table class="table table-striped cl-table">
        <thead>
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Phone</th>
                <th>Branch</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var customer in Model.Items)
        {
            <tr>
                <td>@customer.CustomerCode</td>
                <td>@customer.FullName</td>
                <td>@customer.PhoneNumber</td>
                <td>@customer.Branch?.Name</td>
                <td><span class="badge cl-status-@customer.Status.ToString().ToLowerInvariant()">@customer.Status</span></td>
                <td>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@customer.CustomerId">View</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@customer.CustomerId">Edit</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
    @await Html.PartialAsync("_Pagination", Model, ViewData)
}
