@model PagedResult<Customer>
@{
    ViewData["Title"] = "Customers Directory";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1 fw-bold">Customer Directory</h1>
        <p class="text-muted mb-0">Manage customer accounts, credit limits, balances, and multi-branch details.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-area="" asp-controller="Exports" asp-action="CustomersCsv">📥 Export CSV</a>
        <a class="btn btn-outline-secondary" asp-area="" asp-controller="Exports" asp-action="CustomersJson">📥 Export JSON</a>
        <a class="btn btn-outline-secondary" asp-action="Import">📤 Import CSV</a>
        <a class="btn btn-primary" asp-action="Create">➕ Register Customer</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="cl-search-box w-100" style="max-width: none;">
                    <span class="cl-search-icon">🔍</span>
                    <input type="text" name="search" value="@ViewData["search"]" class="form-control cl-table-search" placeholder="Search by customer name, code, or phone number..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    @foreach (var s in Enum.GetNames(typeof(CustomerStatus)))
                    {
                        <option value="@s" selected="@(s == (string?)ViewData["status"])">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

@if (!Model.Items.Any())
{
    <div class="card p-5 text-center text-muted">
        <h5>No customers found.</h5>
        <p>Register your first customer or try adjusting your search terms.</p>
    </div>
}
else
{
    <div class="table-responsive cl-table-wrapper">
        <table class="table cl-table" id="customerTable">
            <thead>
                <tr>
                    <th>Customer Code</th>
                    <th>Full Name</th>
                    <th>Phone Number</th>
                    <th>Branch</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var customer in Model.Items)
            {
                <tr>
                    <td class="fw-bold">
                        <span class="badge bg-light text-dark border">@customer.CustomerCode</span>
                    </td>
                    <td class="fw-semibold">
                        <a asp-action="Details" asp-route-id="@customer.CustomerId" class="text-decoration-none">
                            @customer.FullName
                        </a>
                    </td>
                    <td>@customer.PhoneNumber</td>
                    <td>@customer.Branch?.Name</td>
                    <td><span class="badge cl-status-@customer.Status.ToString().ToLowerInvariant()">@customer.Status</span></td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@customer.CustomerId">View Details</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@customer.CustomerId">Edit</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="mt-3">
        @await Html.PartialAsync("_Pagination", Model, ViewData)
    </div>
}
